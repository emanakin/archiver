# Copy to .env. Generate secrets using scripts/setup.ps1 or scripts/setup.sh.
POSTGRES_PASSWORD=replace-with-random-hex
INTERNAL_API_TOKEN=replace-with-random-hex
DASHBOARD_USER=owner
DASHBOARD_PASSWORD_HASH='replace-with-caddy-bcrypt-hash'
APP_ORIGIN=http://localhost:8080
SITE_ADDRESS=:8080
BIND_ADDRESS=127.0.0.1
HOST_HTTP_PORT=8080
HOST_HTTPS_PORT=8443
# Real read-only workspace. Package the reviewed client and initialize the worker
# key before starting. Actions require separate validation and explicit enablement.
ADAPTER_MODE=read_only
WORKER_POLL_SECONDS=3
DM_POLL_INTERVAL_SECONDS=900
# Optional for a single archive and newly sent DMs. Launch with compose.captions.yaml.
DM_DEFAULT_ACCOUNT_ID=
DM_DEFAULT_FROM=
DM_AUTO_MUSIC=false
DM_CAPTION_MODEL=
DM_CAPTION_VISION_MODEL=
DM_CAPTION_SOURCES=
DM_CAPTION_V2=true
DM_EDITORIAL_MODEL=qwen2.5:1.5b-instruct
DM_REEL_INGEST=true
# Enable after the reviewed Reel pilot and caption replay pass.
DM_CAPTION_AUTOPOST=false
DM_REEL_AUTOPOST=false
DM_SPOTIFY_PLAYLIST_ID=
DM_SPOTIFY_REFRESH_MINUTES=240
DM_SELF_RECEIPTS=false
# Required for workspaces that store new originals in Cloudflare R2.
# Set CONTENT_STORAGE_BACKEND=r2 to require R2 even while setup is incomplete.
# CONTENT_R2_BUCKET=your-private-bucket
# CONTENT_R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
