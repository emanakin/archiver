FROM python:3.12-slim@sha256:5e2bdb1b0d542d5039cffb8181c65930093949194a65c365dfb1b0fe13a4fa5b
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 INTERNAL_API_TOKEN=test-token-for-local-tests-only-123456 DATABASE_URL=sqlite://
WORKDIR /app
COPY pyproject.toml constraints.txt ./
RUN python -c "import tomllib,subprocess; p=tomllib.load(open('pyproject.toml','rb')); subprocess.check_call(['pip','install','--no-cache-dir','-c','constraints.txt','setuptools>=75','wheel',*p['project']['dependencies'],*p['project']['optional-dependencies']['dev']])"
COPY app ./app
RUN pip install --no-cache-dir --no-deps --no-build-isolation .
COPY migrations ./migrations
COPY alembic.ini ./
COPY tests ./tests
CMD ["python", "-m", "pytest", "-q"]
